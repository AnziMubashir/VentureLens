# VentureLens Environment Configuration
# Mode: "mock" (deterministic offline demo) or "live" (calls Gemini API)
LLM_MODE=mock

# Gemini API Key (only required if LLM_MODE=live)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Host & Port
HOST=127.0.0.1
PORT=8000
